@startuml
!pragma layout smetana
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #334155
skinparam activityBackgroundColor #EFF6FF
skinparam activityBorderColor #2563EB
skinparam activityDiamondBackgroundColor #FFF7ED
skinparam activityDiamondBorderColor #C2410C
skinparam usecaseBackgroundColor #EFF6FF
skinparam usecaseBorderColor #2563EB
skinparam padding 8
title ACT-UC12 — Tiếp nhận và xử lý bảo hành
|Admin|
start
|Admin|
:B1. Tìm và mở yêu cầu bảo hành;
|PC Store|
:B2. Hiển thị thông tin đơn, item/unit, ảnh, thời hạn\nsnapshot và timeline;
|PC Store|
if (Yêu cầu tồn tại?) then (Có)
else (Không)
:E-B2. 404; quay danh sách;
stop
endif
|Admin|
:B3. Chọn tiếp nhận, xử lý, hoàn tất, từ chối hoặc thêm\nghi chú;
|PC Store|
:B4. Khóa request; so version, trạng thái và nội dung bắt\nbuộc;
|PC Store|
if (Action và nội dung hợp lệ?) then (Có)
else (Không)
:E-B4. 409 chuyển sai/stale hoặc422 thiếu kết quả/lý do; giữ\ntrạng thái;
stop
endif
|PC Store|
:B5. Cập nhật trạng thái và append event; tách publicNote\nkhỏi internalNote;
|PC Store|
:B6. Commit, gửi thông báo nếu có; Customer chỉ nhận phần\ncông khai;
stop
@enduml
