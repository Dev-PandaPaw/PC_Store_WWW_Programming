# Python PC Build RAG (server only; same key as Python CART_BACKEND_API_KEY)
PC_BUILD_BASE_URL=http://127.0.0.1:8000
CART_BACKEND_API_KEY=
PC_BUILD_READ_TIMEOUT_SECONDS=210

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/pc_store
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# Server
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false

# Mailpit local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# PixelCore AI: server only. Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# Mục 3.3: embedding model riêng, dùng chung GEMINI_API_KEY với search/chat.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_MS=20000
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=100
AI_GLOBAL_LIMIT_PER_DAY=1000
# Enable with Spring profiles local,semantic. Requires a PostgreSQL server with pgvector installed.
RECOMMENDATION_PRICE_TOLERANCE=0.20
RECOMMENDATION_BEHAVIOR_SOURCE=tracking
RECOMMENDATION_AUTO_SYNC=false
RECOMMENDATION_SYNC_DELAY_MS=300000
# Development authentication is default. Set true only to opt into the sample-account controller.
TEST_LOGIN_ENABLED=false

# Optional isolated integration-test fixtures (order-fixtures profile).
ORDER_DEMO_DB_URL=jdbc:postgresql://localhost:5432/pc_store
ORDER_DEMO_DB_USER=postgres
ORDER_DEMO_DB_PASSWORD=postgres
